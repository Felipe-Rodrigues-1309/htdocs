# Neon connection string with SSL/TLS (DATABASE_URL must remain server-side)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a random token with at least 32 characters; never put it in browser code.
SYNC_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Optional: absolute path to the repository root containing index.html and assets/.
# SITE_ROOT=..
PORT=3000
